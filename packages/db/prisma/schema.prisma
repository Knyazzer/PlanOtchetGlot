generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Жизненный цикл проекта
enum ProjectStatus {
  draft      // Заявка
  active     // Реализация
  done       // Сдан (авто: все WI = done)
  cancelled  // Отменён
  rejected   // Не согласован
}

// Финансовый флаг проекта (отдельная ось)
enum FinancialFlag {
  pending  // Ожидает оплаты
  paid     // Оплачен
}

// Жизненный цикл Work Item (Ось 1)
enum WIStatus {
  draft      // Заявка
  active     // Реализация
  done       // Сдан (авто: все отделы = done)
  cancelled  // Отменён
  rejected   // Не согласован
}

// Источник WI
enum WorkItemSource {
  sync      // импортирован через Google Sheets sync
  manual    // создан пользователем в UI
  separator // визуальный разделитель (месяц) в WorkflowPage
  internal  // внутренняя матрица
}

// Подстатус отдела внутри WI (Ось 2)
enum DeptSubstatus {
  not_started  // Не начат
  in_progress  // В работе
  done         // Завершён
}

// Тип департамента
enum DeptType {
  production  // ТВ, Радио, Дизайн, Бренд медиа, Корп медиа
  support     // Технический, Спецпроекты
  internal    // Финансы, Персонал, Администрация
}

// Тип HR-заявки
enum HRStatusType {
  vacation       // Отпуск
  sick           // Больничный
  remote         // Удалёнка
  business_trip  // Командировка
  day_off        // Отгул
}

// Статус утверждения (HR и другие)
enum ApprovalStatus {
  pending   // На рассмотрении
  approved  // Утверждено
  rejected  // Отклонено
}

// Статус бронирования студии
enum BookingStatus {
  preliminary  // Предварительно (WI в статусе draft)
  confirmed    // Подтверждено (WI в статусе active)
  blocked      // Заблокировано (ремонт и т.п.)
}

// Тип занятости (TV-специфика)
enum EmploymentType {
  staff
  ip_7
  ip_8
  ip_10
  szt
}

// Тип смены (TV-специфика)
enum ShiftType {
  zastroyka
  efir
  demontazh
}

enum ShiftSource {
  matrix
  manual
}

enum SyncType {
  projects
  registry
  matrix
}

enum SyncStatus {
  running
  success
  error
}

// Статус задачи
enum TaskStatus {
  open
  in_progress
  done
}

enum ChangeSource {
  sync
  manual
}

enum DayType {
  zastroyka
  efir
  deadline
  semka
}

enum DealStatus {
  preliminary
  in_progress
  completed
}

// Типы уведомлений — sync + бизнес-события
enum NotificationType {
  // Sync-уведомления (существующие)
  no_matrix
  unmatched_name
  data_conflict
  schedule_change
  // Бизнес-уведомления (новые)
  task_assigned
  task_overdue
  task_closed
  wi_status_changed
  project_status_changed
  dept_connected_to_wi
  hr_request_created
  hr_request_resolved
  studio_conflict
  meeting_invite
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  tabNumber    String?  @map("tab_number")
  isStaff      Boolean  @default(true) @map("is_staff")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shiftEntries        ShiftEntry[]          @relation("UserShifts")
  confirmedShifts     ShiftEntry[]          @relation("ConfirmedByUser")
  assignments         ProjectAssignment[]
  monthlySummaries    MonthlySummary[]
  tasks               Task[]
  taskAssignments     TaskAssignment[]
  notifications       Notification[]
  notificationReads   UserNotificationRead[]
  changeLogs          ChangeLog[]
  matrixNotes         MatrixNote[]
  userRoles           UserAppRole[]
  deptMemberships     DeptMember[]
  managedProjects     Project[]             @relation("AccountManager")
  hrStatuses          HRStatus[]            @relation("HRUser")
  approvedHRStatuses  HRStatus[]            @relation("HRApprover")
  studioBookings               StudioBooking[]
  studioBookingParticipations  StudioBookingParticipant[]
  createdEvents                CalendarEvent[]
  eventParticipations          CalendarEventParticipant[]

  @@map("users")
}

// ─── Project & WorkItem ───────────────────────────────────────────────────────

model Project {
  id               String        @id @default(uuid())
  name             String
  client           String?
  status           ProjectStatus @default(draft)
  financialFlag    FinancialFlag @default(pending)  @map("financial_flag")
  accountManagerId String?       @map("account_manager_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  accountManager User?      @relation("AccountManager", fields: [accountManagerId], references: [id])
  workItems      WorkItem[]

  @@map("projects")
}

// WorkItem заменяет StatusRow. Сохраняет все поля для совместимости с sync-сервисом.
model WorkItem {
  id               String         @id @default(uuid())
  projectId        String?        @map("project_id")     // nullable: WI может существовать до привязки к Project
  name             String
  client           String?
  execProducer     String?        @map("exec_producer")
  lineProducer     String?        @map("line_producer")
  accountManager   String?        @map("account_manager")
  date             DateTime?
  dateConfirmed    Boolean        @default(false) @map("date_confirmed")
  dateApproximate  String?        @map("date_approximate")
  time             String?
  format           String?
  location         String?
  postProduction   String?        @map("post_production")
  status           WIStatus       @default(draft)
  source           WorkItemSource @default(manual)
  matrixUrl        String?        @map("matrix_url")
  sheetMatrixId    String?        @map("sheet_matrix_id")
  notes            String?
  uncertainFields  String[]       @default([]) @map("uncertain_fields")
  googleRowIndex   Int?           @map("google_row_index")
  matrixRegistryId String?        @map("matrix_registry_id")
  blockSlot        Int?           @map("block_slot")
  fieldApprovals   Json?          @map("field_approvals")
  groupSchedule    Json?          @map("group_schedule")
  parentWiId       String?        @map("parent_wi_id")   // иерархия WI (бывший parent_task_id)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  project        Project?         @relation(fields: [projectId],        references: [id])
  parentWi       WorkItem?        @relation("WIChildren", fields: [parentWiId], references: [id])
  childWis       WorkItem[]       @relation("WIChildren")
  matrixRegistry MatrixRegistry?  @relation("RegistryAnchor")
  linkedMatrix   MatrixRegistry?  @relation("ProjectMatrixLink", fields: [matrixRegistryId], references: [id])
  deptLinks      DeptWILink[]
  tasks          Task[]
  studioBookings StudioBooking[]
  assignments    ProjectAssignment[]
  shiftEntries   ShiftEntry[]
  members        ProjectMember[]
  days           ProjectDay[]
  dealWorkItems  DealWorkItem[]

  @@index([date])
  @@map("work_items")
}

// ─── Departments ──────────────────────────────────────────────────────────────

model Department {
  id       String   @id @default(uuid())
  name     String   @unique
  type     DeptType
  parentId String?  @map("parent_id")

  parent   Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children Department[] @relation("DeptTree")
  members  DeptMember[]
  wiLinks  DeptWILink[]
  tasks    Task[]
  events   CalendarEvent[]

  @@map("departments")
}

model DeptMember {
  userId String  @map("user_id")
  deptId String  @map("dept_id")
  isHead Boolean @default(false) @map("is_head")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dept Department @relation(fields: [deptId], references: [id], onDelete: Cascade)

  @@id([userId, deptId])
  @@map("dept_members")
}

// Привязка отдела к WI + подстатус отдела (Ось 2 двуосевой модели)
model DeptWILink {
  id        String        @id @default(uuid())
  deptId    String        @map("dept_id")
  wiId      String        @map("wi_id")
  deadline  DateTime?
  substatus DeptSubstatus @default(not_started) @map("substatus")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  dept     Department @relation(fields: [deptId], references: [id])
  workItem WorkItem   @relation(fields: [wiId],   references: [id], onDelete: Cascade)

  @@unique([deptId, wiId])
  @@map("dept_wi_links")
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(open)
  deadline    DateTime?
  isOverdue   Boolean    @default(false) @map("is_overdue")
  deptId      String?    @map("dept_id")
  wiId        String?    @map("wi_id")
  createdBy   String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  creator     User           @relation(fields: [createdBy], references: [id])
  dept        Department?    @relation(fields: [deptId],    references: [id])
  workItem    WorkItem?      @relation(fields: [wiId],      references: [id])
  assignments TaskAssignment[]

  @@index([deadline])
  @@index([isOverdue])
  @@map("tasks")
}

model TaskAssignment {
  id          String    @id @default(uuid())
  taskId      String    @map("task_id")
  userId      String    @map("user_id")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  completedAt DateTime? @map("completed_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("task_assignments")
}

// ─── HR & Studio ──────────────────────────────────────────────────────────────

model HRStatus {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  type       HRStatusType
  dateFrom   DateTime       @map("date_from")
  dateTo     DateTime       @map("date_to")
  status     ApprovalStatus @default(pending)
  approverId String?        @map("approver_id")
  approvedAt DateTime?      @map("approved_at")
  notes      String?
  createdAt  DateTime       @default(now()) @map("created_at")

  user     User  @relation("HRUser",     fields: [userId],     references: [id])
  approver User? @relation("HRApprover", fields: [approverId], references: [id])

  @@index([userId, dateFrom, dateTo])
  @@map("hr_statuses")
}

model StudioBooking {
  id        String        @id @default(uuid())
  studio    String
  title     String
  wiId      String?       @map("wi_id")
  date      DateTime
  timeFrom  String?       @map("time_from")
  timeTo    String?       @map("time_to")
  status    BookingStatus @default(preliminary)
  reason    String?
  createdBy String        @map("created_by")
  createdAt DateTime      @default(now()) @map("created_at")

  workItem     WorkItem?                  @relation(fields: [wiId],      references: [id])
  creator      User                       @relation(fields: [createdBy], references: [id])
  participants StudioBookingParticipant[]

  @@index([studio, date])
  @@map("studio_bookings")
}

model StudioBookingParticipant {
  bookingId String @map("booking_id")
  userId    String @map("user_id")

  booking StudioBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId],    references: [id])

  @@id([bookingId, userId])
  @@map("studio_booking_participants")
}

// ─── Calendar ─────────────────────────────────────────────────────────────────

model CalendarEvent {
  id        String   @id @default(uuid())
  title     String
  date      DateTime
  timeFrom  String?  @map("time_from")
  timeTo    String?  @map("time_to")
  deptId    String?  @map("dept_id")
  creatorId String   @map("creator_id")
  isGlobal  Boolean  @default(false) @map("is_global")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dept         Department?               @relation(fields: [deptId],    references: [id])
  creator      User                      @relation(fields: [creatorId], references: [id])
  participants CalendarEventParticipant[]

  @@index([date])
  @@map("calendar_events")
}

model CalendarEventParticipant {
  eventId String @map("event_id")
  userId  String @map("user_id")

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId],  references: [id])

  @@id([eventId, userId])
  @@map("calendar_event_participants")
}

// ─── TV-специфика ─────────────────────────────────────────────────────────────

model ProjectDay {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  date       DateTime
  type       DayType
  startTime  String?  @map("start_time")
  timeFrom   String?  @map("time_from")
  timeTo     String?  @map("time_to")
  allDay     Boolean  @default(false) @map("all_day")
  firstMotor String?  @map("first_motor")
  createdAt  DateTime @default(now()) @map("created_at")

  workItem WorkItem @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_days")
}

model ProjectAssignment {
  id             String         @id @default(uuid())
  projectId      String         @map("project_id")
  userId         String?        @map("user_id")
  unmatchedName  String?        @map("unmatched_name")
  roleOnSite     String?        @map("role_on_site")
  shiftFormat    String?        @map("shift_format")
  employmentType EmploymentType @default(staff) @map("employment_type")
  plannedShifts  Int            @default(0) @map("planned_shifts")
  actualShifts   Int            @default(0) @map("actual_shifts")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  workItem     WorkItem     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId],    references: [id])
  shiftEntries ShiftEntry[]

  @@map("project_assignments")
}

model ShiftEntry {
  id           String      @id @default(uuid())
  assignmentId String      @map("assignment_id")
  userId       String      @map("user_id")
  projectId    String      @map("project_id")
  date         DateTime
  shiftType    ShiftType   @map("shift_type")
  confirmed    Boolean     @default(false)
  confirmedBy  String?     @map("confirmed_by")
  confirmedAt  DateTime?   @map("confirmed_at")
  source       ShiftSource @default(matrix)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  assignment      ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user            User              @relation("UserShifts",     fields: [userId],      references: [id])
  workItem        WorkItem          @relation(fields: [projectId],   references: [id])
  confirmedByUser User?             @relation("ConfirmedByUser", fields: [confirmedBy], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([date])
  @@map("shift_entries")
}

model MonthlySummary {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  year           Int
  month          Int
  workingDays    Int      @map("working_days")
  threshold      Int
  totalShifts    Int      @default(0) @map("total_shifts")
  overtimeShifts Int      @default(0) @map("overtime_shifts")
  vacationDays   Int      @default(0) @map("vacation_days")
  updatedBy      String?  @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, year, month])
  @@map("monthly_summaries")
}

model ProjectMember {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  name             String
  position         String?
  shifts           Json      @default("{}")
  employmentType   String?   @map("employment_type")
  ratePlan         Decimal?  @map("rate_plan")         @db.Decimal(12, 2)
  rateFact         Decimal?  @map("rate_fact")         @db.Decimal(12, 2)
  isApproved       Boolean   @default(false)            @map("is_approved")
  fieldApprovals   Json?     @map("field_approvals")
  groupName        String?   @map("group_name")
  telegramUsername String?   @map("telegram_username")
  isFreelancer     Boolean   @default(false)            @map("is_freelancer")
  paymentType      String?   @map("payment_type")
  paymentStatus    String    @default("unpaid")         @map("payment_status")
  paymentAmount    Decimal?  @map("payment_amount")     @db.Decimal(12, 2)
  createdAt        DateTime  @default(now())            @map("created_at")
  updatedAt        DateTime  @updatedAt                 @map("updated_at")

  workItem WorkItem @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_members")
}

// ─── Google Sheets Sync ───────────────────────────────────────────────────────

model MatrixRegistry {
  id             String    @id @default(uuid())
  matrixId       String    @unique @map("matrix_id")
  sheetUrl       String?   @map("sheet_url")
  status         String?
  unit           String[]  @default([])
  client         String?
  name           String?
  format         String?
  date           DateTime?
  producer       String?
  manager        String?
  curator        String?
  projectId      String?   @unique @map("project_id")
  googleRowIndex Int?      @map("google_row_index")
  hasShiftsData  Boolean?  @map("has_shifts_data")
  shiftsCache    Json?     @map("shifts_cache")
  lastSyncedAt   DateTime? @map("last_synced_at")
  projectName    String?   @map("project_name")
  kpLink         String?   @map("kp_link")
  brief          String?
  revenuePlan    Float?    @map("revenue_plan")
  source         String    @default("google")
  templateId     String?   @map("template_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workItem       WorkItem?        @relation("RegistryAnchor",    fields: [projectId], references: [id])
  dealMatrices   DealMatrix[]
  linkedProjects WorkItem[]       @relation("ProjectMatrixLink")
  notes          MatrixNote[]
  documents      MatrixDocument[]

  @@map("matrix_registry")
}

model MatrixTemplate {
  id        String   @id @default(uuid())
  name      String
  sheetUrl  String   @map("sheet_url")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("matrix_templates")
}

model SheetConfig {
  id           String    @id @default(uuid())
  tableKey     String    @unique @map("table_key")
  sheetUrl     String?   @map("sheet_url")
  apiKey       String?   @map("api_key")
  cachedData   Json?     @map("cached_data")
  lastSyncedAt DateTime? @map("last_synced_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("sheet_configs")
}

model MatrixNote {
  id        String   @id @default(uuid())
  matrixId  String   @map("matrix_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  matrix MatrixRegistry @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId],   references: [id], onDelete: Cascade)

  @@map("matrix_notes")
}

model MatrixDocument {
  id        String   @id @default(uuid())
  matrixId  String   @map("matrix_id")
  name      String
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  matrix MatrixRegistry @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@map("matrix_documents")
}

model SyncLog {
  id           String     @id @default(uuid())
  type         SyncType
  targetId     String?    @map("target_id")
  status       SyncStatus @default(running)
  changesCount Int        @default(0) @map("changes_count")
  errors       Json       @default("[]")
  startedAt    DateTime   @default(now()) @map("started_at")
  finishedAt   DateTime?  @map("finished_at")

  @@map("sync_logs")
}

// ─── Deals ────────────────────────────────────────────────────────────────────

model Deal {
  id        String     @id @default(uuid())
  name      String?
  client    String?
  status    DealStatus @default(preliminary)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  workItems  DealWorkItem[]
  matrices   DealMatrix[]

  @@map("deals")
}

// DealStatusRow → DealWorkItem (переименован)
model DealWorkItem {
  dealId String @map("deal_id")
  wiId   String @map("wi_id")

  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  workItem WorkItem @relation(fields: [wiId],   references: [id], onDelete: Cascade)

  @@id([dealId, wiId])
  @@map("deal_work_items")
}

model DealMatrix {
  dealId   String @map("deal_id")
  matrixId String @map("matrix_id")

  deal   Deal           @relation(fields: [dealId],   references: [id], onDelete: Cascade)
  matrix MatrixRegistry @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@id([dealId, matrixId])
  @@map("deal_matrices")
}

// ─── Notifications & Audit ────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  message    String
  userId     String?          @map("user_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user  User?                  @relation(fields: [userId], references: [id])
  reads UserNotificationRead[]

  @@index([userId, isRead])
  @@map("notifications")
}

model UserNotificationRead {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  notificationId String   @map("notification_id")
  readAt         DateTime @default(now()) @map("read_at")

  user         User         @relation(fields: [userId],         references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@map("user_notification_reads")
}

model ChangeLog {
  id         String       @id @default(uuid())
  entityType String       @map("entity_type")
  entityId   String       @map("entity_id")
  field      String?
  oldValue   String?      @map("old_value")
  newValue   String?      @map("new_value")
  changedBy  String?      @map("changed_by")
  source     ChangeSource @default(manual)
  changedAt  DateTime     @default(now()) @map("changed_at")

  user User? @relation(fields: [changedBy], references: [id])

  @@map("change_logs")
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────

model AppRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles       UserAppRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserAppRole {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AppPermission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  @@map("permissions")
}

model RolePermission {
  roleId     String @map("role_id")
  permission String

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}
