generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  employee
  admin
  producer
}

enum StatusRowStatus {
  request
  negotiation
  connecting
  preproduction
  production
  postproduction
  delivered
  rejected
  cancelled
  manual
}

enum StatusRowSource {
  projects_table
  manual
  separator
}

enum EmploymentType {
  staff
  ip_7
  ip_8
  ip_10
  szt
}

enum ShiftType {
  zastroyka
  efir
  demontazh
}

enum ShiftSource {
  matrix
  manual
}

enum SyncType {
  projects
  registry
  matrix
}

enum SyncStatus {
  running
  success
  error
}

enum NotificationType {
  no_matrix
  unmatched_name
  data_conflict
  schedule_change
}

enum TaskStatus {
  open
  in_progress
  done
}

enum ChangeSource {
  sync
  manual
}

enum DayType {
  zastroyka
  efir
  deadline
  semka
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(employee)
  tabNumber    String?  @map("tab_number")
  isStaff      Boolean  @default(true) @map("is_staff")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shiftEntries       ShiftEntry[]        @relation("UserShifts")
  confirmedShifts    ShiftEntry[]        @relation("ConfirmedByUser")
  assignments        ProjectAssignment[]
  monthlySummaries   MonthlySummary[]
  tasks              Task[]
  taskAssignments    TaskAssignment[]
  notifications          Notification[]
  notificationReads      UserNotificationRead[]
  changeLogs             ChangeLog[]
  matrixNotes            MatrixNote[]
  userRoles              UserAppRole[]

  @@map("users")
}

model StatusRow {
  id              String          @id @default(uuid())
  client          String?
  name            String
  execProducer    String?         @map("exec_producer")
  lineProducer    String?         @map("line_producer")
  accountManager  String?         @map("account_manager")
  date            DateTime?
  dateConfirmed   Boolean         @default(false) @map("date_confirmed")
  dateApproximate String?         @map("date_approximate")
  time            String?
  format          String?
  location        String?
  postProduction  String?         @map("post_production")
  status          StatusRowStatus @default(request)
  source          StatusRowSource @default(projects_table)
  matrixUrl       String?         @map("matrix_url")
  sheetMatrixId   String?         @map("sheet_matrix_id")
  notes           String?
  uncertainFields String[]        @default([]) @map("uncertain_fields")
  googleRowIndex  Int?            @map("google_row_index")
  matrixRegistryId String?        @map("matrix_registry_id")
  blockSlot       Int?            @map("block_slot")
  fieldApprovals  Json?           @map("field_approvals")
  groupSchedule   Json?           @map("group_schedule")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  matrixRegistry  MatrixRegistry?
  linkedMatrix    MatrixRegistry? @relation("ProjectMatrixLink", fields: [matrixRegistryId], references: [id])
  assignments     ProjectAssignment[]
  shiftEntries    ShiftEntry[]
  days            ProjectDay[]
  dealStatusRows  DealStatusRow[]
  members         ProjectMember[]

  @@index([date])
  @@map("status_rows")
}

model ProjectDay {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  date       DateTime
  type       DayType
  startTime  String?  @map("start_time")
  timeFrom   String?  @map("time_from")
  timeTo     String?  @map("time_to")
  allDay     Boolean  @default(false) @map("all_day")
  firstMotor String?  @map("first_motor")
  createdAt  DateTime @default(now()) @map("created_at")

  statusRow StatusRow @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_days")
}

model MatrixRegistry {
  id           String    @id @default(uuid())
  matrixId     String    @unique @map("matrix_id")
  sheetUrl     String?   @map("sheet_url")
  status       String?
  unit         String[]  @default([])
  client       String?
  name         String?
  format       String?
  date         DateTime?
  producer     String?
  manager      String?
  curator      String?
  projectId      String?  @unique @map("project_id")
  googleRowIndex Int?     @map("google_row_index")
  hasShiftsData  Boolean? @map("has_shifts_data")
  shiftsCache    Json?    @map("shifts_cache")
  lastSyncedAt   DateTime? @map("last_synced_at")
  projectName    String?   @map("project_name")
  kpLink         String?   @map("kp_link")
  brief          String?
  revenuePlan    Float?    @map("revenue_plan")
  source         String    @default("google")
  templateId     String?   @map("template_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  statusRow      StatusRow?      @relation(fields: [projectId], references: [id])
  dealMatrices   DealMatrix[]
  linkedProjects StatusRow[]     @relation("ProjectMatrixLink")
  ganttTasks     GanttTask[]
  notes          MatrixNote[]
  documents      MatrixDocument[]

  @@map("matrix_registry")
}

model ProjectAssignment {
  id              String         @id @default(uuid())
  projectId       String         @map("project_id")
  userId          String?        @map("user_id")
  unmatchedName   String?        @map("unmatched_name")
  roleOnSite      String?        @map("role_on_site")
  shiftFormat     String?        @map("shift_format")
  employmentType  EmploymentType @default(staff) @map("employment_type")
  plannedShifts   Int            @default(0) @map("planned_shifts")
  actualShifts    Int            @default(0) @map("actual_shifts")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  statusRow    StatusRow    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  shiftEntries ShiftEntry[]

  @@map("project_assignments")
}

model ShiftEntry {
  id           String      @id @default(uuid())
  assignmentId String      @map("assignment_id")
  userId       String      @map("user_id")
  projectId    String      @map("project_id")
  date         DateTime
  shiftType    ShiftType   @map("shift_type")
  confirmed    Boolean     @default(false)
  confirmedBy  String?     @map("confirmed_by")
  confirmedAt  DateTime?   @map("confirmed_at")
  source       ShiftSource @default(matrix)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  assignment   ProjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User              @relation("UserShifts", fields: [userId], references: [id])
  statusRow    StatusRow         @relation(fields: [projectId], references: [id])
  confirmedByUser User?          @relation("ConfirmedByUser", fields: [confirmedBy], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([date])
  @@map("shift_entries")
}

model MonthlySummary {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  year          Int
  month         Int
  workingDays   Int      @map("working_days")
  threshold     Int
  totalShifts   Int      @default(0) @map("total_shifts")
  overtimeShifts Int     @default(0) @map("overtime_shifts")
  vacationDays  Int      @default(0) @map("vacation_days")
  updatedBy     String?  @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, year, month])
  @@map("monthly_summaries")
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      TaskStatus @default(open)
  createdBy   String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  creator         User             @relation(fields: [createdBy], references: [id])
  taskAssignments TaskAssignment[]

  @@map("tasks")
}

model TaskAssignment {
  id          String    @id @default(uuid())
  taskId      String    @map("task_id")
  userId      String    @map("user_id")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  completedAt DateTime? @map("completed_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@map("task_assignments")
}

model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  message    String
  userId     String?          @map("user_id")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  user  User?                  @relation(fields: [userId], references: [id])
  reads UserNotificationRead[]

  @@index([userId, isRead])
  @@map("notifications")
}

model UserNotificationRead {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  notificationId String   @map("notification_id")
  readAt         DateTime @default(now()) @map("read_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@map("user_notification_reads")
}

model ChangeLog {
  id         String       @id @default(uuid())
  entityType String       @map("entity_type")
  entityId   String       @map("entity_id")
  field      String?
  oldValue   String?      @map("old_value")
  newValue   String?      @map("new_value")
  changedBy  String?      @map("changed_by")
  source     ChangeSource @default(manual)
  changedAt  DateTime     @default(now()) @map("changed_at")

  user User? @relation(fields: [changedBy], references: [id])

  @@map("change_logs")
}

enum DealStatus {
  preliminary
  in_progress
  completed
}

model Deal {
  id        String     @id @default(uuid())
  name      String?
  client    String?
  status    DealStatus @default(preliminary)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  statusRows   DealStatusRow[]
  matrices     DealMatrix[]

  @@map("deals")
}

model DealStatusRow {
  dealId      String @map("deal_id")
  statusRowId String @map("status_row_id")

  deal      Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  statusRow StatusRow @relation(fields: [statusRowId], references: [id], onDelete: Cascade)

  @@id([dealId, statusRowId])
  @@map("deal_status_rows")
}

model DealMatrix {
  dealId   String @map("deal_id")
  matrixId String @map("matrix_id")

  deal   Deal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  matrix MatrixRegistry @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@id([dealId, matrixId])
  @@map("deal_matrices")
}

model MatrixTemplate {
  id        String   @id @default(uuid())
  name      String
  sheetUrl  String   @map("sheet_url")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("matrix_templates")
}

model ProjectMember {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  name             String
  position         String?
  shifts           Json      @default("{}")
  employmentType   String?   @map("employment_type")
  ratePlan         Decimal?  @map("rate_plan") @db.Decimal(12, 2)
  rateFact         Decimal?  @map("rate_fact") @db.Decimal(12, 2)
  isApproved       Boolean   @default(false) @map("is_approved")
  fieldApprovals   Json?     @map("field_approvals")
  groupName        String?   @map("group_name")
  telegramUsername String?   @map("telegram_username")
  isFreelancer     Boolean   @default(false) @map("is_freelancer")
  paymentType      String?   @map("payment_type")
  paymentStatus    String    @default("unpaid") @map("payment_status")
  paymentAmount    Decimal?  @map("payment_amount") @db.Decimal(12, 2)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  statusRow StatusRow @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_members")
}

// SheetConfig хранит URL и API-ключи для всех внешних источников данных.
// Ключи (tableKey): projects, registry, employees_buffer, freelancers, kfpd,
//   internal_registry, drive_folder.
// Примечание: для ключа drive_folder поле sheetUrl содержит URL папки Google Drive
//   (не таблицы) — это намеренно, колонка используется как универсальное поле URL.
model SheetConfig {
  id           String    @id @default(uuid())
  tableKey     String    @unique @map("table_key")
  /// URL источника данных. Для большинства ключей — Google Sheets URL.
  /// Для drive_folder — URL папки Google Drive.
  sheetUrl     String?   @map("sheet_url")
  apiKey       String?   @map("api_key")
  cachedData   Json?     @map("cached_data")
  lastSyncedAt DateTime? @map("last_synced_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("sheet_configs")
}

model GanttTask {
  id             String    @id @default(uuid())
  matrixId       String    @map("matrix_id")
  name           String
  startDate      DateTime? @map("start_date")
  deadline       DateTime? @map("deadline")
  done           Boolean   @default(false)
  order          Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  matrix MatrixRegistry @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@map("gantt_tasks")
}

model MatrixNote {
  id        String   @id @default(uuid())
  matrixId  String   @map("matrix_id")
  userId    String   @map("user_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")

  matrix MatrixRegistry @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("matrix_notes")
}

model MatrixDocument {
  id        String   @id @default(uuid())
  matrixId  String   @map("matrix_id")
  name      String
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  matrix MatrixRegistry @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@map("matrix_documents")
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────

model AppRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles       UserAppRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserAppRole {
  userId String  @map("user_id")
  roleId String  @map("role_id")

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AppPermission {
  id          String @id @default(uuid())
  name        String @unique
  description String?

  @@map("permissions")
}

model RolePermission {
  roleId     String @map("role_id")
  permission String

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
  @@map("role_permissions")
}

// ──────────────────────────────────────────────────────────────────────────────

model SyncLog {
  id           String     @id @default(uuid())
  type         SyncType
  targetId     String?    @map("target_id")
  status       SyncStatus @default(running)
  changesCount Int        @default(0) @map("changes_count")
  errors       Json       @default("[]")
  startedAt    DateTime   @default(now()) @map("started_at")
  finishedAt   DateTime?  @map("finished_at")

  @@map("sync_logs")
}
