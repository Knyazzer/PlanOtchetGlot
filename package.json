{
  "name": "tv-shifts",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "esbuild", "prisma", "msw"]
  },
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @tv-shifts/db generate",
    "db:migrate": "pnpm --filter @tv-shifts/db migrate",
    "db:seed": "pnpm --filter @tv-shifts/db seed",
    "test": "pnpm -r test",
    "db:studio": "prisma studio --schema packages/db/prisma/schema.prisma",
    "db:migrate:test": "bash -c 'set -a && source .env && set +a && DATABASE_URL=$TEST_DATABASE_URL pnpm --filter @tv-shifts/db migrate:test'"
  }
}
