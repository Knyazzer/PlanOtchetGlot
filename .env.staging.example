# .env.staging — конфигурация staging-окружения.
# Скопируй в .env.staging и заполни реальными значениями.
# Запуск: docker compose -f docker-compose.staging.yml --env-file .env.staging up -d

# Database (staging — отдельная БД, не prod!)
POSTGRES_USER=tvshifts_staging
POSTGRES_PASSWORD=change-me-staging
POSTGRES_DB=tvshifts_staging
DATABASE_URL=postgresql://tvshifts_staging:change-me-staging@postgres_staging:5432/tvshifts_staging

# Auth
JWT_SECRET=change-me-to-a-long-random-string-for-staging

# App URLs — staging сервер слушает на порту 8080
WEB_URL=http://staging.your-domain.ru:8080
VITE_API_URL=http://staging.your-domain.ru:8080/api

# Google Sheets (можно те же ключи, что и в prod, или тестовые таблицы)
GOOGLE_API_KEY=
GOOGLE_PROJECTS_SHEET_ID=
GOOGLE_REGISTRY_SHEET_ID=

# Google Service Account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Google Drive OAuth2
GOOGLE_DRIVE_OWNER_EMAIL=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
